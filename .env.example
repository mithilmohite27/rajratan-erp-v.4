# Rajratan ERP - Environment Variables
# Copy this file to .env and fill in values for the sheet you want to use.

# Google OAuth Client ID
# Get this from: console.cloud.google.com -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Owner Google account email.
# Matching this email makes the signed-in user Owner with access to all modules.
VITE_OWNER_EMAIL=owner_email_here

# Active Google Sheets Spreadsheet ID
# Use the real production sheet ID for live work, or a copied demo/test sheet ID
# for development and testing. Do not hardcode sheet IDs in source code.
VITE_SHEET_ID=your_google_sheet_id_here

# Optional display-only label shown inside the app.
# Accepted values: production, demo, test, staging. Leave blank to show
# "Active Google Sheet" without exposing the Sheet ID.
VITE_SHEET_ENV=

# Backend / Vercel Serverless variables
# These are server-only secrets and must NOT use the VITE_ prefix.
# Configure these in Vercel project environment variables before using /api/config.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SPREADSHEET_ID=
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
